{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "barbara-auris",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "preview_urls": true,
  "main": "worker.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
